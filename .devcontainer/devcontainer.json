{
  "name": "SuperKart Deployment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": { "label": "Backend API", "onAutoForward": "notify", "visibility": "public" },
    "8501": { "label": "Frontend App", "onAutoForward": "notify", "visibility": "public" }
  },
  "postStartCommand": "bash .devcontainer/start_services.sh"
}
